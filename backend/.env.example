# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB - Local with Compass)
DATABASE_URL="mongodb://localhost:27017/commutemate"

# For MongoDB Atlas (optional - to use later)
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/commutemate?retryWrites=true&w=majority"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Email (for work email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@commutemate.in

# Firebase (push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Petrol cost defaults (INR per km)
DEFAULT_PETROL_COST_PER_KM=6.5

# Matching config
MAX_PICKUP_BUFFER_METRES=600
MAX_DETOUR_MINUTES=5
OTP_EXPIRY_MINUTES=20
